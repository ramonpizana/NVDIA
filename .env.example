# Límite de precio en pesos mexicanos. Los resultados se ordenan del menor al mayor.
MAX_PRICE_MXN=80000

# Cuenta SMTP usada sólo para enviar alertas. En Gmail, crea una App Password;
# no uses tu contraseña normal. SMTP_PASSWORD reemplaza la variable antigua PSWRD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu-correo@gmail.com
SMTP_PASSWORD=pega_aqui_tu_app_password
EMAIL_FROM=tu-correo@gmail.com
EMAIL_TO=tu-correo@gmail.com
